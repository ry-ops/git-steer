# git-steer web — Combined backend API + React frontend
# Build: docker buildx build --platform linux/amd64 -t ghcr.io/ry-ops/git-steer-web:<tag> -f Dockerfile.web --push .

# ── Stage 1: Build frontend ────────────────────────────────────────────────────
FROM node:22-alpine AS frontend
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ .
RUN npx vite build

# ── Stage 2: Build backend ─────────────────────────────────────────────────────
FROM node:22-alpine AS backend
WORKDIR /app
# Copy pre-installed node_modules (includes private git deps)
COPY package.json tsconfig.json ./
COPY node_modules/ node_modules/
COPY src/ src/
RUN npx tsc

# ── Stage 3: Runtime ───────────────────────────────────────────────────────────
FROM node:22-alpine
WORKDIR /app

RUN addgroup -S steer && adduser -S steer -G steer

COPY package.json ./
COPY --from=backend /app/node_modules/ node_modules/
COPY --from=backend /app/dist/ dist/
COPY --from=frontend /web/dist/ web-dist/
COPY bin/ bin/

RUN chown -R steer:steer /app
USER steer

EXPOSE 4300

CMD ["node", "bin/web.js"]
